# Loaded automatically from the repository root. A variable already set in the
# environment is left as-is. No keys are committed.
JEV_API_KEY=
JEV_MODEL=jev-1.14.0
DEMO_PASSWORD=demo123
# Optional real MuleSoft login regression:
MULESOFT_USERNAME=
MULESOFT_PASSWORD=

# Optional runtime field writer: full OpenAI-compatible chat/completions URL.
# Also requires content.enabled and explicit pricing/budgets in the case.
DUIT_WRITER_ENDPOINT=
DUIT_WRITER_MODEL=
DUIT_WRITER_API_KEY=
# Optional stable local HTTP API bearer token (otherwise generated at startup).
DUIT_API_TOKEN=

# Corporate runner floor: standard (default), restricted, or local (no models).
# DUIT_PRIVACY_MODE=restricted
# Built-in model endpoint origins, comma-separated; empty explicitly denies all.
# DUIT_MODEL_ALLOWED_ORIGINS=https://api.typesafe.ai
